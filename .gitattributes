# LF in the repository AND on checkout: deploy scripts and systemd units run
# on the board's Linux side, so native (CRLF) checkouts on Windows would break them.
* text=auto eol=lf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.pdf  binary
*.docx binary
*.pt   binary
*.npz  binary

# Large recorded data: keep diffs quiet
*.jsonl -diff
